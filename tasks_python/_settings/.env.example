# --- DATA LAKE (MINIO) ---
# Host (Windows): localhost:9000 | dentro do container worker: minio:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=usuario
MINIO_SECRET_KEY=senha
MINIO_REGION=us-east-1

# Camadas do lakehouse (100% parquet, sem banco relacional)
BUCKET_BRONZE=bronze
BUCKET_SILVER=silver
BUCKET_GOLD=gold

# --- EXTRAÇÃO FTP (MTE / PDET) ---
FTP_HOST=ftp.mtps.gov.br
FTP_BASE=/pdet/microdados
FTP_TIMEOUT=180
FTP_MAX_RETRIES=5

# --- STAGING (download + descompactação temporária) ---
STAGING_DIR=C:/staging_mtps

# --- PARQUET ---
PARQUET_COMPRESSION=zstd
PARQUET_COMPRESSION_LEVEL=3
